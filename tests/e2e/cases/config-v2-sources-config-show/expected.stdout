grund_config_version = 2
project_name = "example"

[schema]
marker = "§"
shorthand = "canonical"
id_format = "{kind}-{slug}"
slug_pattern = "[a-z][a-z0-9-]*"
number_pattern = "\\d+"
section_separator = "."
heading_depth = "must"

[schema.sources]
languages = ["markdown", "rust", "notes"]
declarations = "any-comment"
exclude = ["generated", "/docs/archive"]
respect_gitignore = false

[schema.sources.extensions]
rustdoc = "rust"
note = "notes"

[schema.sources.definitions.notes]
class = "source"
comment_prefixes = ["%%", "#"]
doc_comments = "shell"
docstrings = "off"

[schema.notes.lines]
must = 3

[schema.notes.columns]
must = 100

[schema.notes.text]
must = true

[schema.kinds.FS]
files = ["requirements.md"]

[presentation]
trigger = "$$"

[presentation.fmt]
anchors = "github"
links = "index"
exclude = []
