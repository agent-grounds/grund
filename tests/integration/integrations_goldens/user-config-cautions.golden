--- file home/.tmux.conf
# >>> grund integrations (v1) >>>
# grund citation integration for tmux.
# tmux cannot make text clickable, so this binds a key that hands the copied
# buffer to the installed `grund-open` resolver, which resolves the §<ID>
# citation and opens its declaration.
# Paste into tmux.conf, or let `grund integrations tmux --write` manage it.
#
# prefix + g opens the citation currently copied to the tmux buffer; use copy
# mode to select a §<ID> first, then prefix + g. The buffer may also hold the
# location an agent printed beside a citation — `path:line` — which opens the
# same way: grund-open tells the two shapes apart itself.
#
# #{q:...} shell-quotes the buffer so the selection reaches grund-open as one
# argument, never evaluated as shell source — the buffer is arbitrary text.
#
# Both bindings cd to #{pane_current_path} first: run-shell and display-popup
# start in the tmux *server's* directory, not the pane's, and grund-open finds
# the repository by walking up from its working directory — without the cd, a
# click works only when the server happened to start inside the repository. The
# path is #{q:}-quoted like the buffer.
bind-key g run-shell 'cd #{q:pane_current_path} && grund-open #{q:buffer_sample}'

# prefix + G peeks instead: the declaration opens in a popup over the session
# and closes when you quit the pager, so reading a citation costs no window
# switch. Requires tmux 3.2+ for display-popup; on older tmux this binding is
# inert and prefix + g still works.
bind-key G display-popup -E -w 80% -h 60% 'cd #{q:pane_current_path} && grund-open --peek #{q:buffer_sample}'
# <<< grund integrations (v1) <<<

--- end
--- dir xdg/
--- dir xdg/grund/
--- file xdg/grund/config.toml
[reference]
conversation = "link"
conversation = "plain"
conversation_target = "file"
marker = "§"
[reference.agents.nobody]
conversation_target = "web"
[reference.agents.codex]
conversation_target = "vscode"

--- end
