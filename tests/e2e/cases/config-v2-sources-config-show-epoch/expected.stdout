grund_config_version = 2
project_name = "example"

[schema]
marker = "§"
shorthand = "canonical"
id_format = "{kind}-{slug}"
slug_pattern = "[a-z][a-z0-9-]*"
number_pattern = "\\d+"
section_separator = "."
heading_depth = "must"

[schema.sources]
languages = ["markdown", "json", "rust", "c", "cpp", "java", "kotlin", "scala", "swift", "javascript", "typescript", "csharp", "php", "python", "go", "ruby", "sql", "lua", "haskell", "lisp", "scheme", "clojure", "ada"]
declarations = "doc-comments"
exclude = []
respect_gitignore = true

[schema.notes.lines]
must = 3

[schema.notes.columns]
must = 100

[schema.notes.text]
must = true

[schema.kinds.FS]
files = ["requirements.md"]

[presentation]
trigger = "$$"

[presentation.fmt]
anchors = "github"
links = "index"
exclude = []
